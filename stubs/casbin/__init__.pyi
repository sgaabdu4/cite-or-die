from collections.abc import Callable

from casbin.persist.adapters import StringAdapter

class Model:
    def __init__(self) -> None: ...
    def load_model_from_text(self, text: str) -> None: ...

class Enforcer:
    def __init__(self, model: Model, adapter: StringAdapter) -> None: ...
    def enforce(self, *rvals: object) -> bool: ...
    def add_function(self, name: str, func: Callable[..., bool]) -> None: ...
